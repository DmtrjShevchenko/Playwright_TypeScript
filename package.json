{
  "name": "playwright_typescript",
  "version": "1.0.0",
  "description": "UI (SauceDemo) and API (Restful Booker) autotests on Playwright + TypeScript",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed --workers=1",
    "test:watch": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "typescript": "^5.9.3"
  }
}
